params {
    gvcfs              = 'gs://cpg-seqera-trial-test/gvcf/*.g.vcf.gz'
    outdir             = 'gs://cpg-seqera-trial-test/rbceq2'
    reference_genome   = 'GRCh38'
    rbceq2_container   = 'australia-southeast1-docker.pkg.dev/seqera-trial/images/rbceq2:2.4.1-561d8a3'
    bcftools_container = 'australia-southeast1-docker.pkg.dev/seqera-trial/images/nf_bcftools:1.23.1-1'
    metamist_container = 'australia-southeast1-docker.pkg.dev/seqera-trial/images/metamist:dataproc'
    cohorts            = 'COH11572,COH11598'
    use_metamist       = true
    metamist_project   = 'seqera-trial'
    local_cohort       = 'local'
    output_version     = 'v1'
    output_pdfs        = true
    min_depth          = 20
    min_gq             = 30
}

process {
    executor = 'google-batch'
    // container = 'australia-southeast1-docker.pkg.dev/seqera-trial/images/metamist:dataproc'
}

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    local {
        process.executor                 = 'local'
        docker.enabled                   = true
        docker.runOptions                = '--platform linux/amd64'   // the arm64 workaround, scoped to local only
        params.use_metamist              = false // local uses params.gvcfs glob
        params.rbceq2_container          = 'rbceq2:2.4.1'
        params.bcftools_container        = 'staphb/bcftools:1.21'
        params.gvcfs                     = 'test_data/gvcfs/*.g.vcf.gz'
        params.outdir                    = 'results'
    }
}

manifest {
    name            = 'populationgenomics/popgen_rbceq2'
    description     = 'A stripped back demo for Seqera Platform'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '1.0.0'
}

plugins {
    id 'nf-schema@2.1.1'
}

includeConfig 'conf/modules.config'